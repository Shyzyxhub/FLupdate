<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minefit.xerxestireiron</groupId>
        <artifactId>FLupdate</artifactId>
        <version>2.6</version>
    </parent>

    <artifactId>FarLandsAgain</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <!-- API → compile proprement les commandes et Event API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Dépend de Utility + NMS -->
        <dependency>
            <groupId>com.minefit.xerxestireiron</groupId>
            <artifactId>Utility</artifactId>
            <version>2.6</version>
        </dependency>

        <!-- Désactivé temporairement - v1_21_R1 ne compile pas -->
        <!--
        <dependency>
            <groupId>com.minefit.xerxestireiron</groupId>
            <artifactId>v1_21_R1</artifactId>
            <version>2.6</version>
        </dependency>
        -->

    </dependencies>

    <build>
        <!-- Pour inclure plugin.yml / config.yml -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- Maven Shade Plugin pour créer un JAR avec tous les modules -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
